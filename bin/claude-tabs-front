#!/usr/bin/env python3
"""HTTP front end sitting in front of ttyd.

Four paths are answered here, everything else (assets, websocket) is relayed to
ttyd untouched:

    /new      redirects to /?arg=<uuid>, so the tab's address becomes the
              conversation's own and reloading reopens it instead of creating one
    /resume   lists the conversations, both running and stored on disk
    /         redirects to /resume
    /title    the name of a conversation, which the terminal page polls in order
              to name the tab

The terminal page itself is relayed, but completed with an injected script that
does three things ttyd leaves undone: it names the tab after the conversation
rather than after the path of the command, it brings a tab whose connection
dropped back on its own once the servers answer again, and it makes Ctrl+V
paste text into the terminal.
"""

import gzip
import html
import json
import os
import re
import socket
import subprocess
import threading
import time
import urllib.parse
import uuid
from pathlib import Path

def settings():
    """Environment first, then the file install.sh writes, then the defaults."""
    values = {"CLAUDE_TABS_PORT": "7681", "CLAUDE_TABS_TTYD_PORT": "7682",
              "CLAUDE_TABS_DIR": str(Path.home())}
    try:
        for line in (Path.home() / ".config/claude-tabs/env").read_text().splitlines():
            key, _, value = line.partition("=")
            if key.strip() in values and value.strip():
                values[key.strip()] = value.strip()
    except OSError:
        pass
    values.update({k: v for k, v in os.environ.items() if k in values})
    return values


_settings = settings()
PORT = int(_settings["CLAUDE_TABS_PORT"])
TTYD_PORT = int(_settings["CLAUDE_TABS_TTYD_PORT"])
WORKDIR = Path(_settings["CLAUDE_TABS_DIR"])
TMUX = ["tmux", "-L", "claude-tabs", "-f", str(Path.home() / ".config/claude-tabs/tmux.conf")]
STORE = Path.home() / ".claude/projects" / re.sub(r"[/._]", "-", str(WORKDIR))
REGISTRY = Path.home() / ".claude/sessions"
try:
    VERSION = (Path(__file__).resolve().parent.parent / "VERSION").read_text().strip()
except OSError:
    VERSION = "unknown"
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
MAX_SESSIONS = 60
TITLE_LENGTH = 60


# --- taking stock of the conversations --------------------------------------------

def running_sessions():
    """Identifiers of the live tmux sessions, with whether a client is attached."""
    try:
        output = subprocess.run(
            TMUX + ["list-sessions", "-F", "#{session_name}\t#{session_attached}"],
            capture_output=True, text=True, timeout=5,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    running = {}
    for line in output.splitlines():
        name, _, attached = line.partition("\t")
        if UUID_RE.match(name):
            running[name] = attached.strip() not in ("", "0")
    return running


def first_message(path):
    """First real user message, the fallback when nothing better names a session."""
    try:
        with path.open(encoding="utf-8", errors="replace") as f:
            for _, line in zip(range(400), f):
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if entry.get("type") != "user":
                    continue
                content = entry.get("message", {}).get("content")
                if not isinstance(content, str):
                    continue
                text = content.strip()
                if text and not text.startswith("<"):
                    return " ".join(text.split())[:90]
    except OSError:
        pass
    return None


def last_ai_title(path, tail=262144):
    """Latest name Claude gave the conversation, read from the end of the transcript."""
    try:
        with path.open("rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - tail))
            chunk = f.read()
    except OSError:
        return None
    if size > tail:
        chunk = chunk.partition(b"\n")[2]
    title = None
    for line in chunk.splitlines():
        if b'"ai-title"' not in line:
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if entry.get("type") == "ai-title" and entry.get("aiTitle"):
            title = entry["aiTitle"]
    return title


_titles = {}


def conversation_title(path):
    """Name of a conversation, cached for as long as its transcript stays put."""
    try:
        stat = path.stat()
    except OSError:
        return None
    fingerprint = (stat.st_mtime_ns, stat.st_size)
    known = _titles.get(path)
    if known and known[0] == fingerprint:
        return known[1]
    title = last_ai_title(path) or first_message(path)
    _titles[path] = (fingerprint, title)
    return title


def inventory():
    running = running_sessions()
    cards = {}
    if STORE.is_dir():
        transcripts = sorted(STORE.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
        for path in transcripts[:MAX_SESSIONS]:
            ident = path.stem
            if not UUID_RE.match(ident):
                continue
            cards[ident] = {
                "id": ident,
                "title": conversation_title(path) or f"conversation {ident[:8]}",
                "date": path.stat().st_mtime,
                "live": ident in running,
                "open": running.get(ident, False),
            }
    for ident, attached in running.items():
        if ident not in cards:
            cards[ident] = {
                "id": ident, "title": f"session {ident[:8]} (no message yet)",
                "date": time.time(), "live": True, "open": attached,
            }
    return sorted(cards.values(), key=lambda c: (not c["live"], -c["date"]))


def shorten(text):
    text = " ".join(text.split())
    return text if len(text) <= TITLE_LENGTH else text[: TITLE_LENGTH - 1].rstrip() + "…"


def claude_state(ident):
    """The record Claude keeps about the process holding this tmux window.

    It is the only source that follows a conversation switch or a rename made from
    inside the tab, since the address bar never changes.
    """
    best = None
    try:
        records = list(REGISTRY.glob("*.json"))
    except OSError:
        return None
    for record in records:
        try:
            data = json.loads(record.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError, UnicodeDecodeError):
            continue
        if not str(data.get("tmux", "")).startswith(f"{ident}:"):
            continue
        if not Path(f"/proc/{data.get('pid', 0)}").is_dir():
            continue
        if best is None or data.get("updatedAt", 0) > best.get("updatedAt", 0):
            best = data
    return best


def session_name(ident):
    """Tab name, plus the conversation actually open behind that tab."""
    state = claude_state(ident)
    live = state.get("sessionId") if state else None
    if live and not UUID_RE.match(live):
        live = None
    target = live or ident

    title = None
    path = STORE / f"{target}.jsonl"
    if path.is_file():
        title = conversation_title(path)
    if not title and state and state.get("nameSource") != "derived":
        title = state.get("name")
    return shorten(title) if title else f"claude {target[:8]}", target


def since(timestamp):
    gap = max(0, time.time() - timestamp)
    for limit, unit, label in ((60, 1, "s"), (3600, 60, "min"), (86400, 3600, "h")):
        if gap < limit:
            return f"{int(gap // unit)} {label} ago"
    return f"{int(gap // 86400)} d ago"


# --- the /resume page -------------------------------------------------------------

PAGE = """<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Claude sessions</title>
<style>
  :root {{ color-scheme: dark; }}
  body {{ margin: 0; padding: 2rem 1rem; background: #1e1e1e; color: #e6e6e6;
         font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, sans-serif; }}
  main {{ max-width: 46rem; margin: 0 auto; }}
  header {{ display: flex; align-items: baseline; justify-content: space-between;
            gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }}
  h1 {{ font-size: 1.25rem; margin: 0; font-weight: 600; }}
  .fresh {{ background: #d97757; color: #1e1e1e; text-decoration: none; font-weight: 600;
            padding: .5rem .9rem; border-radius: .5rem; }}
  .fresh:hover {{ filter: brightness(1.1); }}
  ul {{ list-style: none; margin: 0; padding: 0; }}
  li {{ border-top: 1px solid #333; }}
  a.item {{ display: flex; gap: .75rem; align-items: baseline; padding: .8rem .25rem;
            color: inherit; text-decoration: none; }}
  a.item:hover {{ background: #262626; }}
  .title {{ flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
            white-space: nowrap; }}
  .state {{ font-size: .75rem; padding: .1rem .5rem; border-radius: 1rem;
            border: 1px solid #444; color: #9a9a9a; white-space: nowrap; }}
  .live {{ border-color: #3f7d4f; color: #7bc98f; }}
  .date {{ font-size: .8rem; color: #8a8a8a; white-space: nowrap; }}
  p.empty {{ color: #8a8a8a; }}
  footer {{ margin-top: 2rem; font-size: .8rem; color: #7a7a7a; }}
  code {{ font-family: ui-monospace, monospace; }}
</style></head><body><main>
<header><h1>Claude sessions — {workdir}</h1>
<a class="fresh" href="/new">New session</a></header>
{list}
<footer>Sessions marked running live in tmux; the others are replayed from their
transcript. Bookmark one with Ctrl+D to come straight back to it. From the shell:
<code>claude-tabs list</code>. — claude-tabs {version}</footer>
</main></body></html>
"""


def resume_page():
    cards = inventory()
    if not cards:
        listing = '<p class="empty">No conversation yet.</p>'
    else:
        rows = []
        for card in cards:
            if card["open"]:
                state, css = "open", "state live"
            elif card["live"]:
                state, css = "running", "state live"
            else:
                state, css = "on disk", "state"
            rows.append(
                f'<li><a class="item" href="/?arg={card["id"]}">'
                f'<span class="title">{html.escape(card["title"])}</span>'
                f'<span class="{css}">{state}</span>'
                f'<span class="date">{since(card["date"])}</span></a></li>'
            )
        listing = "<ul>" + "".join(rows) + "</ul>"
    return PAGE.format(workdir=html.escape(WORKDIR.name or str(WORKDIR)),
                       list=listing, version=html.escape(VERSION))


# --- the terminal page ------------------------------------------------------------

# Three scripts, injected into ttyd's page. The first one takes the tab's name
# in hand: ttyd calls it "<title> | <command> (<host>)", whereas the
# conversation's own name, asked for again and again, follows a rename or a
# switch made inside the tab. The second one keeps the tab alive across a
# restart of the servers, and the third one gives Ctrl+V back to the browser.
INJECTION = """<script>
(function () {
  var id = new URLSearchParams(location.search).get('arg');
  var descriptor = Object.getOwnPropertyDescriptor(Document.prototype, 'title');
  var pinned = null;
  Object.defineProperty(document, 'title', {
    configurable: true,
    get: function () { return descriptor.get.call(document); },
    set: function (value) {
      descriptor.set.call(document, pinned !== null ? pinned : String(value).split(' | ')[0]);
    }
  });
  if (!id) { return; }
  var timer = null;
  var refresh = function () {
    clearTimeout(timer);
    fetch('/title?id=' + encodeURIComponent(id))
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data && data.title) {
          pinned = data.title;
          descriptor.set.call(document, pinned);
        }
      })
      .catch(function () {})
      .then(function () { timer = setTimeout(refresh, 10000); });
  };
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) { refresh(); }
  });
  refresh();
})();
(function () {
  // ttyd gives up as soon as the browser reports an error on its socket, and
  // the tab then waits for a keystroke: restarting the servers leaves every
  // open tab on "Press ⏎ to Reconnect". The socket is wrapped here, so that a
  // tab whose connection drops waits for ttyd to answer again and reloads
  // itself, which reattaches the conversation still running in tmux.
  var Native = window.WebSocket;
  if (!Native || !window.fetch) { return; }
  var leaving = false, waiting = false, timer = null, box = null;
  var current = null, opened = 0;

  var notice = function (text) {
    if (!box) {
      box = document.createElement('div');
      box.style.cssText = 'position:fixed;top:1em;left:50%;transform:translateX(-50%);' +
        'z-index:2147483647;padding:.4em .9em;border-radius:4px;background:#222;color:#ddd;' +
        'font:13px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;box-shadow:0 2px 10px #0008';
      (document.body || document.documentElement).appendChild(box);
    }
    box.textContent = text;
    box.style.display = '';
  };

  var settle = function () {          // the socket came back on its own
    waiting = false;
    clearTimeout(timer);
    if (box) { box.style.display = 'none'; }
  };

  var probe = function (delay) {
    if (!waiting) { return; }
    fetch('/token', { cache: 'no-store' })
      .then(function (r) {
        if (!r.ok) { throw new Error(r.status); }
        if (waiting) { location.reload(); }
      })
      .catch(function () {
        timer = setTimeout(function () { probe(Math.min(delay * 1.5, 5000)); }, delay);
      });
  };

  // A connection that dies within seconds of opening means the process behind
  // the tab is exiting at once, not that the server went away: reloading would
  // only spin the page. ttyd already reconnects on its own in that case.
  var lost = function (lifetime) {
    if (leaving || waiting || lifetime < 5000) { return; }
    waiting = true;
    notice('Connection lost — waiting for the server, the tab comes back on its own.');
    timer = setTimeout(function () { probe(500); }, 400);
  };

  var going = function () { leaving = true; };
  window.addEventListener('beforeunload', going);
  window.addEventListener('pagehide', going);
  window.addEventListener('pageshow', function () { leaving = false; });

  // A tab left in the background is slowed down by the browser, which delays
  // the timers above by up to a minute, and sometimes freezes the page
  // altogether. Coming back to the tab therefore starts the search again at
  // once, and a connection found dead is treated as lost even if its event
  // never arrived.
  var awaken = function () {
    if (document.hidden) { return; }
    if (waiting) {
      clearTimeout(timer);
      probe(500);
    } else if (current && current.readyState > 1 && opened) {
      lost(Date.now() - opened);
    }
  };
  document.addEventListener('visibilitychange', awaken);
  window.addEventListener('focus', awaken);

  window.WebSocket = function (url, protocols) {
    var socket = arguments.length > 1 ? new Native(url, protocols) : new Native(url);
    current = socket;
    socket.addEventListener('open', function () { opened = Date.now(); settle(); });
    socket.addEventListener('close', function () {
      lost(opened ? Date.now() - opened : 0);
    });
    return socket;
  };
  window.WebSocket.prototype = Native.prototype;
  ['CONNECTING', 'OPEN', 'CLOSING', 'CLOSED'].forEach(function (name, value) {
    window.WebSocket[name] = value;
  });
})();
(function () {
  // Ctrl+V never pasted anything: xterm takes the key for itself, cancels the
  // browser's own paste and sends ^V to the program, where Claude Code reads
  // the clipboard by its own means — which finds images but no text. The key
  // is caught here before xterm sees it, so the browser pastes as it would in
  // any field, and the terminal receives the text. A clipboard holding an
  // image gives no text, and ^V is then handed to the program after all, which
  // leaves Claude Code's own way of taking images untouched.
  var field = function () { return document.querySelector('.xterm-helper-textarea'); };
  var relaying = false;

  document.addEventListener('keydown', function (event) {
    if (relaying || !event.ctrlKey || event.altKey || event.metaKey) { return; }
    if (event.key !== 'v' && event.key !== 'V') { return; }
    var target = field();
    if (!target) { return; }
    target.focus();
    event.stopPropagation();          // and no preventDefault: the paste happens
  }, true);

  // The browser hands a paste to whatever holds the focus, and xterm listens
  // only on its own hidden field: a paste made after a click outside the
  // terminal would otherwise be lost.
  document.addEventListener('paste', function (event) {
    var target = field();
    if (!target) { return; }
    var data = event.clipboardData;
    var text = data ? data.getData('text/plain') : '';

    if (!text && data && data.files.length) {
      event.preventDefault();         // an image: let the program ask for it
      relaying = true;
      target.focus();
      target.dispatchEvent(new KeyboardEvent('keydown', {
        key: 'v', code: 'KeyV', ctrlKey: true, bubbles: true, cancelable: true
      }));
      relaying = false;
      return;
    }

    if (event.target === target || !text) { return; }
    event.preventDefault();
    var carrier = new DataTransfer();
    carrier.setData('text/plain', text);
    target.focus();
    target.dispatchEvent(new ClipboardEvent('paste',
      { clipboardData: carrier, bubbles: true, cancelable: true }));
  }, true);
})();
</script>
"""

_index = {}


def dechunk(body):
    out = b""
    while True:
        line, separator, rest = body.partition(b"\r\n")
        if not separator:
            return out or body
        try:
            size = int(line.split(b";")[0], 16)
        except ValueError:
            return out or body
        if size == 0:
            return out
        out += rest[:size]
        body = rest[size + 2:]


def terminal_page():
    """ttyd's own terminal page, fetched once and completed."""
    if "html" in _index:
        return _index["html"]
    with socket.create_connection(("127.0.0.1", TTYD_PORT), timeout=10) as upstream:
        upstream.sendall(b"GET / HTTP/1.1\r\nHost: localhost\r\n"
                         b"Accept-Encoding: identity\r\nConnection: close\r\n\r\n")
        raw = b""
        while True:
            chunk = upstream.recv(65536)
            if not chunk:
                break
            raw += chunk
    head, _, body = raw.partition(b"\r\n\r\n")
    headers = head.decode("latin-1").lower()
    if "transfer-encoding: chunked" in headers:
        body = dechunk(body)
    if "content-encoding: gzip" in headers:
        body = gzip.decompress(body)
    page = body.decode("utf-8", errors="replace")
    if "</head>" in page:
        page = page.replace("</head>", INJECTION + "</head>", 1)
    else:
        page = INJECTION + page
    _index["html"] = page
    return page


# --- server -----------------------------------------------------------------------

def response(body, status="200 OK", content_type="text/html; charset=utf-8", headers=()):
    payload = body.encode("utf-8")
    head = [f"HTTP/1.1 {status}", f"Content-Type: {content_type}",
            f"Content-Length: {len(payload)}", "Cache-Control: no-store", "Connection: close"]
    head.extend(headers)
    return ("\r\n".join(head) + "\r\n\r\n").encode("utf-8") + payload


def relay(source, destination):
    try:
        while True:
            data = source.recv(65536)
            if not data:
                break
            destination.sendall(data)
    except OSError:
        pass
    finally:
        for sock in (source, destination):
            try:
                sock.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass


def serve(client):
    """Answer the four local paths, otherwise splice the connection onto ttyd as is."""
    with client:
        client.settimeout(30)
        buffer = b""
        try:
            while b"\r\n\r\n" not in buffer and len(buffer) < 65536:
                chunk = client.recv(4096)
                if not chunk:
                    return
                buffer += chunk
        except OSError:
            return
        client.settimeout(None)

        request_line = buffer.split(b"\r\n", 1)[0].decode("latin-1")
        parts = request_line.split(" ")
        target = parts[1] if len(parts) > 2 else "/"
        path, _, query = target.partition("?")

        if path == "/new":
            client.sendall(response("", "302 Found", "text/plain",
                                    (f"Location: /?arg={uuid.uuid4()}",)))
            return
        if path in ("/resume", "/sessions"):
            client.sendall(response(resume_page()))
            return
        if path == "/title":
            ident = urllib.parse.parse_qs(query).get("id", [""])[0]
            if UUID_RE.match(ident):
                title, live = session_name(ident)
            else:
                title, live = None, None
            client.sendall(response(json.dumps({"title": title, "id": live}),
                                    content_type="application/json; charset=utf-8"))
            return
        if path == "/" and not query:
            client.sendall(response("", "302 Found", "text/plain", ("Location: /resume",)))
            return
        if path in ("/", "/index.html"):
            try:
                client.sendall(response(terminal_page()))
            except OSError:
                client.sendall(response("<h1>ttyd is not answering</h1>", "502 Bad Gateway"))
            return

        # Only the first request of a connection is read here; the rest is
        # spliced onto ttyd byte for byte. A browser reusing such a connection
        # would therefore ask ttyd for the terminal page directly and get it
        # without the injected script, so anything but a websocket handshake is
        # forwarded with Connection: close and the connection serves once.
        if b"upgrade" not in buffer.split(b"\r\n\r\n", 1)[0].lower():
            head, separator, rest = buffer.partition(b"\r\n\r\n")
            head = re.sub(rb"\r\n(connection|keep-alive):[^\r\n]*", b"", head,
                          flags=re.IGNORECASE) + b"\r\nConnection: close"
            buffer = head + separator + rest

        try:
            upstream = socket.create_connection(("127.0.0.1", TTYD_PORT), timeout=10)
        except OSError:
            client.sendall(response("<h1>ttyd is not answering</h1>", "502 Bad Gateway"))
            return
        with upstream:
            upstream.settimeout(None)
            upstream.sendall(buffer)
            thread = threading.Thread(target=relay, args=(upstream, client), daemon=True)
            thread.start()
            relay(client, upstream)
            thread.join()


def main():
    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(("127.0.0.1", PORT))
    listener.listen(64)
    print(f"Front end ready on http://localhost:{PORT} (ttyd on {TTYD_PORT})", flush=True)
    while True:
        client, _ = listener.accept()
        threading.Thread(target=serve, args=(client,), daemon=True).start()


if __name__ == "__main__":
    main()
